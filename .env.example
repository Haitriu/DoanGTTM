# Database
POSTGRES_USER=voltrail
POSTGRES_PASSWORD=voltrail
POSTGRES_DB=voltrail
DATABASE_URL=postgresql+psycopg://voltrail:voltrail@localhost:5432/voltrail

# Redis
REDIS_URL=redis://localhost:6379/0

# Routing Adapter
OSRM_URL=http://localhost:5000

# Charging Stations Adapter (Open Charge Map)
# Đăng ký miễn phí tại: https://openchargemap.org/site/develop/api
OPEN_CHARGE_MAP_KEY=your_open_charge_map_api_key_here

# Map Tiles (Mapbox)
# Đăng ký miễn phí tại: https://account.mapbox.com/auth/signup/
# Sau khi đăng ký, vào Account → Access Tokens → Copy Default public token
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# Google Maps qua SerpApi (Directions + Places) — TÙY CHỌN
# Lấy key tại: https://serpapi.com/dashboard (free tier giới hạn ~100 lượt/tháng,
# hết quota sẽ tự fallback về hành lang QL1A tĩnh, không sập app).
# Dùng cho: tuyến đường lái xe thật (google_maps_directions) và gợi ý vị trí
# trạm sạc trên bản đồ (google_maps, KHÔNG có công suất kW nên không dùng lập kế hoạch).
SERPAPI_KEY=your_serpapi_key_here
